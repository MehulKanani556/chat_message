{
  "name": "chat-message-app",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron/main.js",
  "homepage": ".",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@react-oauth/google": "^0.12.1",
    "@reduxjs/toolkit": "^2.5.1",
    "@yudiel/react-qr-scanner": "^2.3.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "agora-rtc-react": "^2.3.0",
    "axios": "^1.7.9",
    "cra-template": "1.2.0",
    "date-fns": "^4.1.0",
    "electron-is-dev": "^2.0.0",
    "emoji-picker-react": "^4.12.0",
    "formik": "^2.4.6",
    "framer-motion": "^12.7.2",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^2.16.105",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-country-region-selector": "^4.0.2",
    "react-dom": "^19.0.0",
    "react-draggable": "^4.4.6",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.4.0",
    "react-phone-input-2": "^2.15.1",
    "react-qr-barcode-scanner": "^2.1.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.5.2",
    "react-scripts": "5.0.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.17",
    "wavesurfer.js": "^7.9.1",
    "web-vitals": "^4.2.4",
    "xlsx": "^0.18.5",
    "yup": "^1.6.1"
  },
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"npm run electron-start\"",
    "react-start": "react-scripts start",
    "electron-start": "wait-on http://localhost:3000/ && electron .",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000/ && electron .\"",
    "electron-pack": "electron-builder -c.extraMetadata.main=build/electron/main.js",
    "preelectron-pack": "npm run build",
    "pack-win": "npm run electron-pack -- --win",
    "pack-mac": "npm run electron-pack -- --mac"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^23.3.13",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.chatmessage.app",
    "productName": "Chat Message App",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "src/assets"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
